        {
            "name": "Linux",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/channel/channelapp/channelapp_nopax.elf",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "${env:DEVKITPPC}/bin/powerpc-eabi-gdb",
            "miDebuggerServerAddress": "localhost:55020",
            "setupCommands": [
